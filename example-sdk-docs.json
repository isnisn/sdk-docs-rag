{
  "_comment": "Copy this to <your-project>/sdk-docs.json and edit the fields. Then run /sdk-docs-rag:ingest inside Claude Code, or python3 $CLAUDE_PLUGIN_ROOT/server/ingest.py --config sdk-docs.json from the shell.",

  "vendor": "nordic",
  "display_name": "Nordic nRF Connect SDK",
  "tool_name": "search_nordic_docs",
  "index_path": ".sdk-docs-index.db",

  "doc_sources": [
    { "path": "ncs/nrf/doc/nrf/_build/html",    "type": "html" },
    { "path": "ncs/zephyr/doc/_build/html",     "type": "html" },
    { "path": "datasheets/device_spec.pdf",     "type": "pdf"  }
  ],

  "chunk_include_patterns": ["*.html", "*.md", "*.rst"],
  "chunk_exclude_patterns": [
    "*_source.html",
    "*genindex*",
    "*search.html",
    "*searchindex.js",
    "*objects.inv",
    "_sources/*",
    "_static/*"
  ],

  "_examples": {
    "_comment": "Alternative configurations for other vendors. Not used at runtime — copy the top-level keys above to match your SDK.",

    "renesas_da16200": {
      "vendor": "renesas",
      "display_name": "Renesas DA16200 FreeRTOS SDK",
      "tool_name": "search_renesas_docs",
      "doc_sources": [
        { "path": "sdk/docs/doxygen/md_files",    "type": "html" },
        { "path": "sdk/docs/doxygen/html",        "type": "html" },
        { "path": "DA16200_Programmer_Guide.pdf", "type": "pdf"  }
      ],
      "chunk_exclude_patterns": [
        "*_source.html",
        "nav*",
        "dir_*",
        "files.html",
        "annotated.html",
        "classes*",
        "functions*",
        "globals*",
        "hierarchy*",
        "modules*",
        "namespace*",
        "pages.html"
      ]
    },

    "espressif_esp_idf": {
      "vendor": "espressif",
      "display_name": "Espressif ESP-IDF",
      "tool_name": "search_esp_idf_docs",
      "doc_sources": [
        { "path": "esp-idf/docs/_build/html", "type": "html" }
      ],
      "chunk_include_patterns": ["*.html", "*.rst"],
      "chunk_exclude_patterns": ["*_source.html", "_sources/*", "_static/*", "*searchindex.js"]
    },

    "stm32_cube_hal": {
      "vendor": "st",
      "display_name": "STM32Cube HAL",
      "tool_name": "search_stm32_docs",
      "doc_sources": [
        { "path": "STM32Cube/Documentation/html", "type": "html" },
        { "path": "datasheets/mcu_reference_manual.pdf", "type": "pdf" }
      ]
    },

    "doxygen_project": {
      "vendor": "myproj",
      "display_name": "My Project Doxygen Docs",
      "tool_name": "search_myproj_docs",
      "doc_sources": [
        { "path": "build/doxygen/html", "type": "html" }
      ],
      "chunk_exclude_patterns": [
        "*_source.html",
        "nav*",
        "dir_*",
        "files.html",
        "annotated.html",
        "classes*",
        "functions*",
        "globals*",
        "hierarchy*",
        "modules*",
        "namespace*",
        "pages.html"
      ]
    }
  }
}
